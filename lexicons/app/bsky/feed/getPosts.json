{
  "lexicon": 1,
  "id": "app.bsky.feed.getPosts",
  "defs": {
    "main": {
      "type": "query",
      "description": "Gets post views for a specified list of posts (by AT-URI).",
      "parameters": {
        "type": "params",
        "required": ["uris"],
        "properties": {
          "uris": { "type": "array", "items": { "type": "string", "format": "at-uri" }, "maxLength": 25 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["posts"],
          "properties": {
            "posts": { "type": "array", "items": { "type": "ref", "ref": "app.bsky.feed.defs#postView" } }
          }
        }
      }
    }
  }
}
